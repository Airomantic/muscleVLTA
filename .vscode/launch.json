{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "infer_muscleVLTA_debug",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "program": "${workspaceFolder}/scripts/infer_musclevlta_debug.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "subProcess": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src:${workspaceFolder}/packages/openpi-client/src",
                "PYTHONUNBUFFERED": "1",
                "LD_LIBRARY_PATH": "",
                "ROS_DOMAIN_ID": "111",
                "XLA_PYTHON_CLIENT_PREALLOCATE": "false"
            },
            "args": [
                "--checkpoint-dir", "${workspaceFolder}/infer_checkpoint/29999",
                "--config-name", "pi05_ar3_force_visuotactile_reactive_lowmem",
                "--gpu", "0",
                "--source", "ros-readonly",
                "--prompt", "Unplug the white charging plug from the white socket and place it on the table",
                "--mode", "reactive",
                "--fps", "15",
                "--ros-domain-id", "111",
                "--front-topic", "/front/color/image_raw",
                "--wrist-topic", "/wrist/color/image_raw",
                "--joint-topic", "/joint_states",
                "--tactile-prefix", "/v3_gripper/tactile",
                "--gripper-address", "192.168.127.10:50008",
                "--force-level", "80",
                "--observation-max-age", "0.5",
                "--observation-timeout", "10",
                "--rerun", "spawn",
                "--output-dir", "${workspaceFolder}/outputs/infer_muscleVLTA_debug"
            ]
        },
